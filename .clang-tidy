---
# C++ Core Guidelines are the style rule set. Checks disabled below are
# deliberate, with the reason given.
Checks: >
  -*,
  cppcoreguidelines-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-loop-convert,
  modernize-use-nodiscard,
  modernize-use-using,
  modernize-make-unique,
  modernize-make-shared,
  misc-throw-by-value-catch-by-reference,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-avoid-non-const-global-variables
# magic-numbers / non-private-members / non-const-globals: too noisy for the
#   legacy code; revisit once the rest is clean.
WarningsAsErrors: ''
# Only this repo's own sources are reported (not core, Qt or Conan headers); CI checks the
# repos out under their repo names, so the anchor holds there too.
HeaderFilterRegex: '.*/openindy-default-plugin/(cf|exchange|functions|sensors|simulations|tools|test|p_factory\.h|tree_util\.h).*'
# FormatStyle: file makes clang-tidy format the code its --fix fix-its produce with the
# .clang-format found above the source file (it does not change what is reported).
FormatStyle: file
